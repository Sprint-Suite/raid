# RAID — environment
# Copy to .env and fill in real values.

# Anthropic API (RAID extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Port (RAID listens here; Apache/PM2 proxies to it)
PORT=3003

# --- Sprint Suite auth hub integration (@suite/auth-client) ---
APP_NAME=raid
HUB_BASE_URL=https://sprintsuite.uk
# The HUB_API_KEY_RAID value from the hub's .env (~/suite-app-keys.txt on prod)
HUB_API_KEY=replace-with-HUB_API_KEY_RAID
# Cookie domain for the app session (the app's own domain)
COOKIE_DOMAIN=sprintraid.uk
# Local app-session store (better-sqlite3)
APP_SESSIONS_DB=./data/raid-sessions.db
